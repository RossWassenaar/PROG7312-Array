<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PaperColor">#FDFBF2</Color>
    <SolidColorBrush x:Key="Ink" Color="#1D3F8C" />
    <SolidColorBrush x:Key="RedPen" Color="#D7263D" />
    <SolidColorBrush x:Key="Pencil" Color="#5E5E5E" />
    <SolidColorBrush x:Key="FaintPencil" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Highlighter" Color="#B3FFF35C" />
    <SolidColorBrush x:Key="StickyYellow" Color="#FFE97A" />
    <SolidColorBrush x:Key="MarginRed" Color="#E58A8A" />

    <FontFamily x:Key="Hand">Ink Free, Segoe UI Symbol</FontFamily>

    <PathGeometry x:Key="ScribbleLoop"
                  Figures="M 8,22 C 6,8 40,2 62,3 C 86,4 98,12 96,22 C 94,34 64,39 44,38 C 20,37 4,31 6,20 C 7,13 18,7 30,6" />

    <DrawingBrush x:Key="RuledPaper" TileMode="Tile"
                  Viewport="0,0,40,36" ViewportUnits="Absolute"
                  Viewbox="0,0,40,36" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource PaperColor}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,40,36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#B9CFEA">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,35,40,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="WobblyLineMask" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M 0,3 C 20,0 40,6 60,3 C 80,0 90,5 100,2">
                <GeometryDrawing.Pen>
                    <Pen Brush="Black" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="DoubleLineMask" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M 0,4 C 30,0 60,8 100,3 M 8,11 C 40,7 70,12 96,8">
                <GeometryDrawing.Pen>
                    <Pen Brush="Black" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <TextDecorationCollection x:Key="RedStrike">
        <TextDecoration Location="Strikethrough">
            <TextDecoration.Pen>
                <Pen Brush="#D7263D" Thickness="2.5" />
            </TextDecoration.Pen>
        </TextDecoration>
    </TextDecorationCollection>

    <Style x:Key="Hole" TargetType="Ellipse">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Fill" Value="#DDD5C2" />
        <Setter Property="Stroke" Value="#C4B9A0" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="ScribbleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Path x:Name="Loop" Stretch="Fill" StrokeThickness="2.4"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="{StaticResource ScribbleLoop}" />
                        <ContentPresenter Margin="26,10,26,12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Loop" Property="Fill" Value="{StaticResource Highlighter}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Loop" Property="Stroke" Value="{StaticResource RedPen}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InkLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="0,0,0,8" />
                        <Border Height="6" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}"
                                OpacityMask="{StaticResource WobblyLineMask}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource RedPen}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource RedPen}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnderlineBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pencil}" />
        <Setter Property="SelectionBrush" Value="#FFE14D" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="4,0,4,2" VerticalAlignment="Bottom" />
                        <Path x:Name="Line" Stretch="Fill" Height="4" VerticalAlignment="Bottom"
                              Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 0,2 C 25,0 50,4 75,1 C 85,0 95,3 100,2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Stroke" Value="{StaticResource Ink}" />
                            <Setter TargetName="Line" Property="StrokeThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StickyNote" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StickyYellow}" />
        <Setter Property="Padding" Value="24,30,24,26" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="2.5" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="290" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
